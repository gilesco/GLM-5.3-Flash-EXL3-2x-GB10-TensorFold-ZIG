-        return s.tree.deepest(prompt, (prompt.len - s.past()) / s.rules.page * s.rules.page, s.step());
+        // a page-aligned prompt may resume its own full-length tail state (the full-hit skip);
+        // otherwise a token stays left for the pass's last row
+        const cap: usize = if (prompt.len % @as(usize, s.rules.page) == 0)
+            prompt.len
+        else
+            (prompt.len - s.past()) / s.rules.page * s.rules.page;
+        return s.tree.deepest(prompt, cap, s.step());
     }
 

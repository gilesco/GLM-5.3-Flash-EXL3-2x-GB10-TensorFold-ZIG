 zig/src/server/tool_parse.zig      | 112 ++++++++++++++++++++++-------
 zig/src/server/tool_parse_test.zig | 104 ++++++++++++++++++++++++++-
 2 files changed, 190 insertions(+), 26 deletions(-)

diff --git a/zig/src/server/tool_parse.zig b/zig/src/server/tool_parse.zig
index c6c4b731c..c1f5dfdf6 100644
--- a/zig/src/server/tool_parse.zig
+++ b/zig/src/server/tool_parse.zig
@@ -164,40 +164,101 @@ pub fn parse(a: Allocator, text: []const u8, tools: []const Value, max_calls: ?u
             continue;
         }
         if (max_calls) |m| if (calls.items.len >= m) continue;
-        const parsed: ?[]Call = blk: {
-            if (tool_dsml.whole(env.payload)) |b| {
-                break :blk tool_dsml.calls(a, b.inner, b.spelling) catch |e| switch (e) {
-                    error.OutOfMemory => return error.OutOfMemory,
-                    error.Invalid => null,
-                };
-            }
-            const one = payload(a, env.payload, &schemas, max_calls != null) catch |e| switch (e) {
-                error.OutOfMemory => return error.OutOfMemory,
-                error.Invalid => break :blk null,
-            };
-            if (one) |c| {
-                const list = try a.alloc(Call, 1);
-                list[0] = c;
-                break :blk list;
+        var start = env.start;
+        var parsed = try offeredCalls(a, env.payload, &schemas, &known, max_calls != null, true);
+        // Prose that quotes the opener ("Qwen's <tool_call>{}") ahead of a call begins the envelope, so the call does
+        // not parse as its payload: the call is the last opener inside it (or one before that, when a value quotes
+        // the opener too), and the quoting prose stays content.
+        // An opener inside an unclosed value of the text before it (a JSON object still open, an <arg_value> or
+        // <parameter=> not yet closed) is a quoted call inside a call the first closer cut: never the call.
+        if (parsed == null and std.ascii.startsWithIgnoreCase(text[env.start..], "<tool_call>")) {
+            const closer = env.end - "</tool_call>".len;
+            var inner = lastOpener(text, env.start + "<tool_call>".len, closer);
+            var tries: usize = 0;
+            while (inner) |s| : (inner = lastOpener(text, env.start + "<tool_call>".len, s)) {
+                tries += 1;
+                if (tries > inner_tries) break;
+                if (insideValue(text[env.start + "<tool_call>".len .. s])) continue;
+                // a salvaged call names an offered tool: the own-name rule is a whole envelope's rule
+                // (the client answers unknown tool and the model corrects itself), not a quoted
+                // fragment's — an example the model quotes in prose must stay prose
+                parsed = try offeredCalls(a, strip(text[s + "<tool_call>".len .. closer]), &schemas, &known, max_calls != null, false);
+                if (parsed != null) {
+                    start = s;
+                    break;
+                }
             }
-            break :blk null;
-        };
-        const good = if (parsed) |list| list.len > 0 and for (list) |c| {
-            if ((try callName(a, c, &known)) == null) break false;
-        } else true else false;
-        if (!good) {
+        }
+        const list = parsed orelse {
             try residue.appendSlice(a, text[env.start..env.end]);
             rejected += 1;
             continue;
-        }
-        for (parsed.?) |c| {
-            if (max_calls == null or calls.items.len < max_calls.?) try calls.append(a, try openaiCall(a, (try callName(a, c, &known)).?, c.arguments));
+        };
+        try residue.appendSlice(a, text[env.start..start]);
+        for (list) |c| {
+            if (max_calls == null or calls.items.len < max_calls.?) try calls.append(a, try openaiCall(a, (try callName(a, c, &known, true)).?, c.arguments));
         }
     }
     try residue.appendSlice(a, text[cursor..]);
     return .{ .content = strip(residue.items), .calls = if (calls.items.len > 0) calls.items else null, .rejected_envelopes = rejected };
 }
 
+/// Openers inside a rejected envelope tried, from the last: a bound keeps a reply of quoted openers linear.
+const inner_tries = 4;
+
+/// Whether an opener after `before` would lie inside a value still open in `before`: a JSON object with more `{`
+/// than `}`, an <arg_value> without its </arg_value>, or a <parameter=...> without its </parameter>.
+fn insideValue(before: []const u8) bool {
+    var depth: isize = 0;
+    for (before) |ch| {
+        if (ch == '{') depth += 1 else if (ch == '}') depth -= 1;
+    }
+    if (depth > 0) return true;
+    const open_value = std.mem.lastIndexOf(u8, before, "<arg_value>");
+    if (open_value) |o| if (std.mem.lastIndexOf(u8, before, "</arg_value>")) |c| {
+        if (c < o) return true;
+    } else return true;
+    const open_param = std.mem.lastIndexOf(u8, before, "<parameter=");
+    if (open_param) |o| if (std.mem.lastIndexOf(u8, before, "</parameter>")) |c| {
+        if (c < o) return true;
+    } else return true;
+    return false;
+}
+
+/// The last ``<tool_call>`` that starts at or after ``from`` and ends by ``before``.
+fn lastOpener(text: []const u8, from: usize, before: usize) ?usize {
+    var last: ?usize = null;
+    var pos = from;
+    while (findCI(text[0..before], "<tool_call>", pos)) |s| : (pos = s + 1) last = s;
+    return last;
+}
+
+/// A payload's calls when it parses whole and each names an offered tool; null when it is not such a call.
+fn offeredCalls(a: Allocator, block: []const u8, schemas: *const tool_params.Schemas, known: *const std.StringArrayHashMapUnmanaged([]const u8), complete: bool, own_name: bool) Allocator.Error!?[]Call {
+    const parsed: ?[]Call = blk: {
+        if (tool_dsml.whole(block)) |b| {
+            break :blk tool_dsml.calls(a, b.inner, b.spelling) catch |e| switch (e) {
+                error.OutOfMemory => return error.OutOfMemory,
+                error.Invalid => null,
+            };
+        }
+        const one = payload(a, block, schemas, complete) catch |e| switch (e) {
+            error.OutOfMemory => return error.OutOfMemory,
+            error.Invalid => break :blk null,
+        };
+        if (one) |c| {
+            const list = try a.alloc(Call, 1);
+            list[0] = c;
+            break :blk list;
+        }
+        break :blk null;
+    };
+    const list = parsed orelse return null;
+    if (list.len == 0) return null;
+    for (list) |c| if ((try callName(a, c, known, own_name)) == null) return null;
+    return list;
+}
+
 /// What closes the call ``text`` ends inside (the model's end token came before its ``
 pub fn closeCall(a: Allocator, text: []const u8, tools: []const Value) Allocator.Error![]const u8 {
     const start = openCall(text) orelse return "";
@@ -239,9 +300,10 @@ fn argumentsClose(a: Allocator, body: []const u8) Allocator.Error![]const u8 {
 /// ``call_name``: the offered tool's spelling; else the name itself when it is 1 to 64 of ``[A-Za-z0-9_-]`` and the
 /// arguments a finite object (a tool the request did not offer is the client's to refuse — the client answers
 /// "unknown tool" and the model corrects itself; upstream PR #415, issue #256); else null.
-fn callName(a: Allocator, c: Call, known: *const std.StringArrayHashMapUnmanaged([]const u8)) Allocator.Error!?[]const u8 {
+fn callName(a: Allocator, c: Call, known: *const std.StringArrayHashMapUnmanaged([]const u8), own_name: bool) Allocator.Error!?[]const u8 {
     const name = strip(c.name);
     if (known.get(try std.ascii.allocLowerString(a, name))) |offered| return offered;
+    if (!own_name) return null;
     if (name.len == 0 or name.len > 64 or c.arguments != .object or !tool_params.finite(c.arguments)) return null;
     for (name) |ch| if (!(std.ascii.isAlphanumeric(ch) or ch == '_' or ch == '-')) return null;
     return name;
diff --git a/zig/src/server/tool_parse_test.zig b/zig/src/server/tool_parse_test.zig
index 80d908938..8ae4e4c09 100644
--- a/zig/src/server/tool_parse_test.zig
+++ b/zig/src/server/tool_parse_test.zig
@@ -159,7 +159,6 @@ test "a call left open that would not parse whole stays the reply's text" {
         "Trying.<tool_call>\n<function=lookup>\n<parameter=n>\n5\n", // before its </parameter>
         "Trying.<tool_call>{\"name\":\"launch rocket!\",\"arguments\":{}}", // no function name
         "Trying.<tool_call>", // nothing written
-        "Trying <tool_call> tags.<tool_call>{\"name\":\"lookup\"}", // an earlier opener would take the closer
     };
     for (replies) |text| {
         try std.testing.expectEqualStrings("", try closeCall(a, text, tools));
@@ -584,6 +583,109 @@ test "GLM pairs from the cached key and value ends are the pairs each key's own
 test {
     _ = @import("tool_parse_visibility_test.zig");
 }
+
+test "prose that quotes the opener ahead of a call does not swallow the call" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"parameters\":{\"properties\":{\"n\":{\"type\":\"integer\"},\"q\":{\"type\":\"string\"}}}}}]")).ok.array;
+    // the model names the labs' formats in its prose, then calls in its own (GLM's, Qwen's JSON, XML)
+    const prose = "Each lab's format differs (<minimax:tool_call>, GLM's xml-ish, Qwen's <tool_call>{})...";
+    const calls = [_][]const u8{
+        "<tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>",
+        "<tool_call>{\"name\":\"lookup\",\"arguments\":{\"n\":7}}</tool_call>",
+        "<tool_call>\n<function=lookup>\n<parameter=n>\n7\n</parameter>\n</function>\n</tool_call>",
+    };
+    for (calls) |call| {
+        const text = try std.mem.concat(a, u8, &.{ prose, call });
+        for ([_]?usize{ null, 1 }) |max_calls| {
+            const r = try parse(a, text, tools, max_calls);
+            try std.testing.expectEqual(@as(usize, 0), r.rejected_envelopes);
+            try std.testing.expectEqual(@as(usize, 1), r.calls.?.len);
+            try std.testing.expectEqualStrings("lookup", r.calls.?[0].get("function").?.get("name").?.string);
+            try std.testing.expectEqualStrings("{\"n\":7}", r.calls.?[0].get("function").?.get("arguments").?.string);
+            try std.testing.expectEqualStrings(prose, r.content);
+        }
+    }
+    // a value that quotes the opener parses whole (no retry); quoted ahead of such a call, the retry goes one opener back
+    const quoting = "<tool_call>lookup<arg_key>q</arg_key><arg_value>grep -c '<tool_call>' log</arg_value></tool_call>";
+    for ([_][]const u8{ quoting, try std.mem.concat(a, u8, &.{ prose, quoting }) }) |text| {
+        const r = try parse(a, text, tools, null);
+        try std.testing.expectEqual(@as(usize, 0), r.rejected_envelopes);
+        try std.testing.expectEqualStrings("{\"q\":\"grep -c '<tool_call>' log\"}", r.calls.?[0].get("function").?.get("arguments").?.string);
+    }
+    // the call found that way still has to name an offered tool, and (one call asked) parse whole, as before
+    const kept = [_]struct { []const u8, ?usize }{
+        .{ "Qwen's <tool_call>{}... <tool_call>launch<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>", null },
+        .{ "Qwen's <tool_call>{}... <tool_call>launch<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>", 1 },
+        .{ "Qwen's <tool_call>{}... <tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value> and then</tool_call>", 1 },
+        .{ "Qwen's <tool_call>{}... <tool_call></tool_call>", null },
+    };
+    for (kept) |c| {
+        const r = try parse(a, c[0], tools, c[1]);
+        try std.testing.expect(r.calls == null);
+        try std.testing.expectEqual(@as(usize, 1), r.rejected_envelopes);
+        try std.testing.expectEqualStrings(c[0], r.content);
+    }
+    // an earlier opener no longer takes the closer that closes the call the end token left open
+    const tags = "Trying <tool_call> tags.<tool_call>{\"name\":\"lookup\"}";
+    try std.testing.expectEqualStrings("</tool_call>", try closeCall(a, tags, tools));
+    const tagged = try parse(a, try std.mem.concat(a, u8, &.{ tags, "</tool_call>" }), tools, null);
+    try std.testing.expectEqualStrings("lookup", tagged.calls.?[0].get("function").?.get("name").?.string);
+    try std.testing.expectEqualStrings("Trying <tool_call> tags.", tagged.content);
+    // a call after the quoted opener that the end token left open closes as before, and parses once closed
+    const open = "Qwen's <tool_call>{}... <tool_call>lookup<arg_key>n</arg_key><arg_value>7";
+    const close = try closeCall(a, open, tools);
+    try std.testing.expectEqualStrings("</arg_value></tool_call>", close);
+    const closed = try parse(a, try std.mem.concat(a, u8, &.{ open, close }), tools, null);
+    try std.testing.expectEqualStrings("{\"n\":7}", closed.calls.?[0].get("function").?.get("arguments").?.string);
+    try std.testing.expectEqualStrings("Qwen's <tool_call>{}...", closed.content);
+    // an unoffered call stays open, as before
+    try std.testing.expectEqualStrings("", try closeCall(a, "Qwen's <tool_call>{}... <tool_call>launch<arg_key>n</arg_key><arg_value>7", tools));
+}
+
+test "an envelope of many quoted openers is rejected in linear time" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\"}}]")).ok.array;
+    var t: Timed = .{ .replies = undefined, .tools = tools, .want = null };
+    for (&t.replies, [_]usize{ 800, 6400 }) |*reply, n| {
+        var r: std.ArrayList(u8) = .empty;
+        for (0..n) |_| try r.appendSlice(a, "<tool_call>{} ");
+        try r.appendSlice(a, "</tool_call>");
+        reply.* = r.items;
+    }
+    try t.linear(); // 8x the openers: near 8x the time, not 64x
+}
+
+test "a cut call whose value quotes a whole call stays content: the retry is for prose ahead of a call" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"lookup\",\"parameters\":{\"properties\":{\"n\":{\"type\":\"integer\"},\"q\":{\"type\":\"string\"}}}}}]")).ok.array;
+    // the first </tool_call> cuts the outer call inside its value; retrying from the inner opener would call lookup(n=7).
+    // The JSON and XML forms stay content (rejected, as before the retry); GLM's lenient form takes the cut outer call
+    // with its q truncated at the inner closer, as it did before - never the quoted inner call.
+    const cut = [_][]const u8{
+        "<tool_call>{\"name\":\"lookup\",\"arguments\":{\"q\":\"<tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>\"}}</tool_call>",
+        "<tool_call>lookup<arg_key>q</arg_key><arg_value><tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value></tool_call></arg_value></tool_call>",
+        "<tool_call>\n<function=lookup>\n<parameter=q>\n<tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>\n</parameter>\n</function>\n</tool_call>",
+        "Note: <tool_call>{\"name\":\"lookup\",\"arguments\":{\"q\":\"<tool_call>lookup<arg_key>n</arg_key><arg_value>7</arg_value></tool_call>\"}}</tool_call>",
+    };
+    for (cut) |text| {
+        for ([_]?usize{ null, 1 }) |max_calls| {
+            const r = try parse(a, text, tools, max_calls);
+            if (r.calls) |c| {
+                const args = c[0].get("function").?.get("arguments").?.string;
+                try std.testing.expect(!std.mem.eql(u8, args, "{\"n\":7}")); // the quoted inner call must never be the call
+            } else {
+                try std.testing.expectEqual(@as(usize, 1), r.rejected_envelopes);
+            }
+        }
+    }
+}
+
 test "a JSON envelope's strings may quote tool-call markup" {
     var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
     defer arena.deinit();

From: GLM-EXL3-2x-GB10 testing line <tensorfold-zig-testing@local>
Subject: glm-cuda: a decode window's MoE shared expert on a side stream beside the routed experts (Mia 1104 0006+0010, adapted to v1.2.3 + the adopted stack)

PROVENANCE: ported from MiaAI-Lab/GLM-5.3-Flash-DGX-Sparks-1104,
patches/engine/0006 (a decode window's shared expert on a side stream
beside the routed experts) + 0010 (the shared-expert side stream drains
before its work's buffers can go) (Apache-2.0, (c) MiaAI Lab) against
TensorFold v1.2.3 (6ec5fa4cb) + this line's adopted 7-patch stack,
2026-11-07, by this line - a hand port (our drift: the two Forward
constructions carry .absorb_mma from our ABSORB_MMA port - the port
adds .side beside it; upstream's flashnext already has the same
pattern (TF_FLASHNEXT_SHARED_SIDE), so the Stream/Event API matches).

MECHANISM (0006): the MoE block ran the shared expert after the routed
experts on one stream. A decode window (not a prompt chunk) now forks
the shared expert's gate/up, SwiGLU, down and put_slot onto a second
stream right after the block's input is ready, and the fill joins it
before the slot combine. The kernels, their inputs and the combine's
order are unchanged, so the bits are the same; only the overlap
changes. Engine.side holds the stream and events, made at init;
TF_GLM_SHARED_SIDE=0 keeps one stream (the kill switch). Prompt chunks
never fork (they fill by row pieces on the main stream).

MECHANISM (0010): a failure between the fork and the join could leave
the side stream running while the caller reused the block's scratch;
teardown synchronized only the main stream. moe.body synchronizes the
side stream on any error from the fork on (errdefer); Engine.deinit
drains it right after the main stream; init's error path drains it
before the buffers' errdefers run. Successful calls are unchanged.

MEASURED (Mia, RTX PRO 6000 sm_120, bench_overlap): 70.6 -> 60.6 us a
MoE layer at one row, 96.5 -> 84.9 us at two (-14/-12%).

PORT NOTES: cuda_moe.zig - Side{stream, fork, join}, Kernels.side
(default null), forks(), body's fork + the 0010 errdefer drain,
fill's join-or-inline + combine, the shared body moved into
sharedRows(). cuda_forward.zig - Forward.side (default null),
moeKernels passes .side only for non-prefill buffers.
cuda_engine.zig - Engine.side, sideStream()/freeSide(), init's
errdefers (0006 freeSide + 0010 drain), deinit's sync + freeSide,
view passes .side for decode buffers only, the verify Forward passes
.side. STAGING: applies on v1.2.3 + the 7-patch stack (verified
byte-identical to the port commit on a fresh checkout); NAMED glm-zz-
TO SORT AFTER THE STACK (the image applies patches alphabetically; the
hunks assume the absorb-mma port's .absorb_mma field). OWNER: this
line; STATUS: EXPERIMENTAL, judged by the moeside window (the content
gate + the decode rows, the definitive protocol).

REBASE (2026-11-07, onto v1.2.4 267c5af6a): the pieces init carries pair now; the
Forward constructions carry l2pf - the side field, sideStream/freeSide, the
constructor, deinit and both Forward call sites re-anchored around them.


REGEN-NOTE (2026-11-15, the v1.2.9 rebase): the body regenerated state-machine style — this patch's owned files jump from their state at this point in the stack to the verified final state; later stack members' edits to shared files ride inside (the end-state replay verifies byte-exact).

diff --git a/zig/src/families/glm/cuda_moe.zig b/zig/src/families/glm/cuda_moe.zig
index 1f21c3881..c90d771ef 100644
--- a/zig/src/families/glm/cuda_moe.zig
+++ b/zig/src/families/glm/cuda_moe.zig
@@ -41,7 +41,26 @@ pub const Scratch = struct {
 };
 
 /// The kernels the block runs: the captured Triton set, the grouped NVFP4 experts, the plan, and glm_ops.
-pub const Kernels = struct { set: glue.Set, experts: *const experts.Kernels, exl3: *const exl3.Kernels, put_slot: cuda.Function, prof: ?*prof_mod.Prof = null };
+/// A decode window's second stream: the shared expert runs there beside the router and the routed experts (the same
+/// kernels on the same rows, so the same bits); `fork` and `join` order it after the block's input and before combine.
+pub const Side = struct { s: cuda.Stream, fork: cuda.Event, join: cuda.Event };
+
+/// The kernels the block runs: the captured Triton set, the grouped NVFP4 experts, the plan, and glm_ops.
+/// `side`: a decode window's shared expert on its own stream (null: on the block's stream, as before).
+/// `fuse`: a decode window's EXL3 experts take the grouped path (TF_GLM_MOE_FUSE=0: off), the same bits.
+pub const Kernels = struct { set: glue.Set, experts: *const experts.Kernels, exl3: *const exl3.Kernels, put_slot: cuda.Function, prof: ?*prof_mod.Prof = null, side: ?Side = null, fuse: bool = false };
+
+/// Whether a decode window's EXL3 experts take the grouped path: the fused select writes their compact picks and
+/// grouping (tf_glm_topk_group: no copy, no group launch) and fill sums the routed slots with the shared expert's row
+/// in the down epilogue (no slot rows, no put_slot, no glue.combine), in glue.combine's own order.
+fn grouped(k: Kernels, l: Layer, rows: usize, prompt: bool) bool {
+    return k.fuse and l.exl3 != null and !prompt and rows >= 1 and rows <= glue.select_group_rows and l.top_k == exl3.top_k;
+}
+
+/// Whether this call forks the shared expert: decode windows with a side stream (prompt chunks fill by row pieces).
+fn forks(k: Kernels, prompt: bool) bool {
+    return k.side != null and !prompt;
+}
 
 /// forward.moe_block: out [rows][dims] fp32 partial; `prompt`: 64-pair items, the prompt kernels, bf16 slot rows.
 pub fn block(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_stride: usize, rows: usize, prompt: bool, out: u64) !void {
@@ -54,15 +73,32 @@ pub fn body(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_str
     const d = l.routed.dims;
     const slots = l.top_k + 1;
     const shared_id: i32 = @intCast(l.count);
+    const forked = forks(k, prompt);
+    // a failure from the fork on leaves no side work behind it: the caller may reuse the scratch or free the buffers
+    errdefer if (forked) k.side.?.s.synchronize() catch {};
+    if (forked) { // the shared expert of every row on the side stream, from the block's input as it stands now
+        const sd = k.side.?;
+        try sd.fork.record(stream);
+        try sd.s.wait(sd.fork);
+        try sharedRows(k, sd.s, l, s, x, x_stride, 0, rows, prompt, !grouped(k, l, rows, prompt));
+        try sd.join.record(sd.s);
+    }
     var stamp = prof_mod.span(k.prof, stream, .router);
     try glue.router(k.set, stream, x, x_stride, l.router, s.mlog, s.router_part, rows, d, l.count);
-    try glue.select(k.set, stream, s.mlog, l.bias, s.pick, s.wts, rows, l.top_k, l.count, l.scale, l.norm);
+    const g = grouped(k, l, rows, prompt);
+    if (g) {
+        const sc = (try exl3.decodeScratch(l.exl3.?, s.x3, rows, l.count, d, l.routed.width, l.routed.limit)) orelse return error.BadWindow;
+        try glue.selectGroup(k.set, stream, s.mlog, l.bias, s.pick, s.wts, rows, l.top_k, l.count, l.scale, l.norm, s.x3.picks, sc.ids, sc.count, sc.members);
+    } else try glue.select(k.set, stream, s.mlog, l.bias, s.pick, s.wts, rows, l.top_k, l.count, l.scale, l.norm);
     stamp.end();
     stamp = prof_mod.span(k.prof, stream, .experts);
     defer stamp.end();
     if (k.prof) |p| p.mark(stream, .router);
     defer if (k.prof) |p| p.mark(stream, .routed);
-    if (l.exl3) |w| return exl3.run(k.exl3, k.experts, stream, w, s.x3, s.plan, x, x_stride, s.pick, slots, rows, l.count, d, l.routed.width, l.routed.limit, prompt, s.ey, s.eact);
+    if (l.exl3) |w| {
+        if (g) return exl3.runGrouped(k.exl3, stream, w, s.x3, x, x_stride, rows, l.count, d, l.routed.width, l.routed.limit);
+        return exl3.run(k.exl3, k.experts, stream, w, s.x3, s.plan, x, x_stride, s.pick, slots, rows, l.count, d, l.routed.width, l.routed.limit, prompt, s.ey, s.eact);
+    }
     const plan: experts.Plan = .{ .route = s.plan, .slots = slots, .experts = l.count + 1, .prompt = prompt, .fact = !prompt and k.experts.fact and l.routed.format == .nvfp4 };
     try experts.route(k.experts, stream, s.pick, rows * slots, plan);
     try experts.run(k.experts, stream, .gate_up, l.routed, plan, x, x_stride, rows, s.eact, shared_id);
@@ -78,13 +114,30 @@ pub fn fill(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_str
     const n = hi - lo;
     const bf16_slots = prompt and l.exl3 == null; // the slot rows: bf16 in an NVFP4 prompt chunk, else fp32
     const eb: usize = if (bf16_slots) 2 else 4;
+    if (grouped(k, l, hi, prompt)) { // body ran the grouped path on rows 0..hi: one fill of them all
+        if (lo != 0) return error.BadFill;
+        if (forks(k, prompt)) try stream.wait(k.side.?.join) else try sharedRows(k, stream, l, s, x, x_stride, 0, hi, prompt, false);
+        return exl3.combineDecode(k.exl3, stream, l.exl3.?, s.x3, hi, l.count, d, l.routed.width, l.routed.limit, s.wts, s.sy, out);
+    }
+    if (forks(k, prompt)) try stream.wait(k.side.?.join) else try sharedRows(k, stream, l, s, x, x_stride, lo, hi, prompt, true);
+    try glue.combine(k.set, stream, s.ey + lo * slots * d * eb, !bf16_slots, s.wts + lo * slots * 4, out, n, d, slots);
+}
+
+/// The shared expert of rows lo..hi on `stream`: [gate | up], SwiGLU, down into `sy`, then with `slot` its rows into the
+/// last slot of `ey` (the grouped decode path reads `sy` itself).
+fn sharedRows(k: Kernels, stream: cuda.Stream, l: Layer, s: Scratch, x: u64, x_stride: usize, lo: usize, hi: usize, prompt: bool, slot: bool) !void {
+    const d = l.routed.dims;
+    const slots = l.top_k + 1;
+    const n = hi - lo;
+    const bf16_slots = prompt and l.exl3 == null;
+    const eb: usize = if (bf16_slots) 2 else 4;
     try projection.matmul(k.set, stream, l.shared_gu, x + lo * x_stride * 2, x_stride, s.sgu + lo * 2 * l.shared * 2, s.mm_part, n, 2 * l.shared, d, false);
     try glue.swiglu(k.set, stream, s.sgu + lo * 2 * l.shared * 2, s.sact + lo * l.shared * 2, s.sxs + lo * (l.shared / 64) * 4, l.routed.limit, n, l.shared);
     try projection.matmul(k.set, stream, l.shared_down, s.sact + lo * l.shared * 2, l.shared, s.sy + lo * d * 4, s.mm_part, n, d, l.shared, true);
+    if (!slot) return;
     var a: cuda.Args = .{};
     a.add(s.sy + lo * d * 4);
     a.add(s.ey + lo * slots * d * eb);
     for ([_]usize{ n, d, slots, l.top_k, @intFromBool(bf16_slots) }) |v| a.add(@as(c_int, @intCast(v)));
     try cuda.launch.launch(k.put_slot, .{ .grid = .{ .x = @intCast((n * d + 255) / 256) }, .block = .{ .x = 256 } }, stream, &a);
-    try glue.combine(k.set, stream, s.ey + lo * slots * d * eb, !bf16_slots, s.wts + lo * slots * 4, out, n, d, slots);
 }
